{
  "name": "megafonito-demo-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "build:web": "astro build --root web",
    "start": "bun run build:web && bun run src/index.ts",
